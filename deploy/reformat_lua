        indent_chunk = indent_chunk,
        right_margin = right_margin,
      }
    file_from_str(
      output_file_name, reformat(input_code_str, Options)
    )
    print(
      str_format('  Formatted code to "%s".', output_file_name)
    )
    print(')')
  end
